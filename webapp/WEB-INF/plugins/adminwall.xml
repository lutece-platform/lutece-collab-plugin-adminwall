<?xml version="1.0" encoding="UTF-8" standalone="no"?><plug-in>
    <name>adminwall</name>
    <class>fr.paris.lutece.portal.service.plugin.PluginDefaultImplementation</class>
    <version>2.0.0-SNAPSHOT</version>
    <documentation/>
    <installation/>
    <changes/>
    <user-guide/>
    <description>adminwall.plugin.description</description>
    <provider>adminwall.plugin.provider</provider>
    <provider-url>http://fr.lutece.paris.fr</provider-url>
    <icon-url>themes/admin/shared/plugins/adminwall/images/adminwall.svg</icon-url>
    <copyright>Copyright</copyright>
    <core-version-dependency>
        <min-core-version>8.0.0</min-core-version>
        <max-core-version/>
    </core-version-dependency>
    <db-pool-required>1</db-pool-required>
    <!-- Admin features parameters -->
    <admin-features>
        <admin-feature>
            <feature-id>ADMINWALL_ACCESS</feature-id>
            <feature-title>adminwall.adminFeature.AdminWall.name</feature-title>
            <feature-description>adminwall.adminFeature.AdminWall.description</feature-description>
            <feature-level>3</feature-level>
            <feature-url>jsp/admin/plugins/adminwall/ManageWall.jsp</feature-url>
            <icon-url>ti ti-messages</icon-url>
      </admin-feature>
    </admin-features>    

    <!-- RBAC of the messages : VIEW, CREATE, DELETE ( any message ) -->
    <rbac-resource-types>
        <rbac-resource-type>
            <rbac-resource-type-class>fr.paris.lutece.plugins.adminwall.service.PostResourceIdService</rbac-resource-type-class>
        </rbac-resource-type>
    </rbac-resource-types>
  	<!-- XPages parameters -->
    <applications>
    </applications>
	<!-- Portlet parameters -->
    <portlets>
   </portlets>
   
   <!-- Dashboard components -->
    <dashboard-components>
        <dashboard-component>
            <dashboard-component-name>ADMINWALL</dashboard-component-name>
            <dashboard-component-class>fr.paris.lutece.plugins.adminwall.web.AdminWallDashboardComponent</dashboard-component-class>
            <dashboard-feature-right>ADMINWALL_ACCESS</dashboard-feature-right>
            <dashboard-zone>1</dashboard-zone>
            <dashboard-zone-order>4</dashboard-zone-order>
        </dashboard-component>
        <!-- the notification zone of the admin header (zone 5 when lutece.dashboard.zones.count=4) : the new messages of the user -->
        <dashboard-component>
            <dashboard-component-name>ADMINWALL_NOTIFICATION</dashboard-component-name>
            <dashboard-component-class>fr.paris.lutece.plugins.adminwall.web.NotificationDashboardComponent</dashboard-component-class>
            <dashboard-feature-right>ADMINWALL_ACCESS</dashboard-feature-right>
            <dashboard-zone>5</dashboard-zone>
            <dashboard-zone-order>1</dashboard-zone-order>
        </dashboard-component>
    </dashboard-components>

    
</plug-in>